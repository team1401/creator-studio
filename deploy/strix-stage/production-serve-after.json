{
  "TCP": {
    "8443": {
      "HTTPS": true
    },
    "9443": {
      "HTTPS": true
    }
  },
  "Web": {
    "<tailscale-host>:8443": {
      "Handlers": {
        "/": {
          "Proxy": "http://localhost:18789"
        }
      }
    },
    "<tailscale-host>:9443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:4180"
        }
      }
    }
  }
}